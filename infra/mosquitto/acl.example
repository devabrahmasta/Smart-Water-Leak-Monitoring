# Salin menjadi `acl` (tidak di-commit). Nama user = device_id untuk perangkat.

# Backend: baca semua data perangkat, kirim cmd ke semua perangkat
user backend
topic read swm/+/telemetry
topic read swm/+/alert
topic read swm/+/status
topic read swm/+/ack
topic write swm/+/cmd
topic write swm/+/config
topic write swm/+/demo

# Perangkat dan simulator: hanya topiknya sendiri (%u = username)
pattern write swm/%u/telemetry
pattern write swm/%u/alert
pattern write swm/%u/status
pattern write swm/%u/ack
pattern read swm/%u/cmd
pattern read swm/%u/config

# Hanya simulator yang menerima skenario demo
user 2
topic read swm/2/demo
