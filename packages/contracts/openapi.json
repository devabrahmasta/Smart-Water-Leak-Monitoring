  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Monitoring"
        ],
        "summary": "Health Check",
        "description": "Pemeriksaan kesehatan sistem (debug, publik tanpa token).",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/v1/summary": {
      "get": {
        "tags": [
          "Summary"
        ],
        "summary": "Ringkasan pemantauan air kos (Beranda)",
        "description": "Mengembalikan data agregasi ringkasan dashboard:\n- today_l: total liter hari ini (WIB)\n- month_l: total liter bulan berjalan\n- last_7_days_end: tanggal hari ini WIB\n- last_7_days_l: deret volume 7 hari terakhir\n- tally: jumlah kamar normal, closed, offline, leak\n- open_alert_count: jumlah alert berstatus OPEN\n- latest_open_alert: alert OPEN terbaru",
        "operationId": "get_summary_v1_summary_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SummaryResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/v1/rooms": {
      "get": {
        "tags": [
          "Rooms"
        ],
        "summary": "Daftar kamar kos dengan status dan volume hari ini",
        "description": "Mengembalikan daftar seluruh kamar kos:\n- filter=all: seluruh kamar\n- filter=attention: kamar bocor (LEAK), offline (OFFLINE), atau tertutup (CLOSED)\n- filter=offline: hanya kamar yang sedang offline (> 30s)",
        "operationId": "get_rooms_v1_rooms_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "filter",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Filter kamar: all | attention | offline",
              "default": "all",
              "title": "Filter"
            },
            "description": "Filter kamar: all | attention | offline"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RoomListResponse"
                }
              }
            }
          },
