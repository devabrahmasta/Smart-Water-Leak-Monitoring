    "/v1/rooms/{room_id}/valve": {
      "post": {
        "tags": [
          "Valve Commands"
        ],
        "summary": "Kirim perintah buka/tutup valve ke kamar",
        "description": "Mengirim perintah buka/tutup valve ke kamar:\n1. Cek kamar dan device terdaftar\n2. Cek perangkat online (last_seen_at <= 30 detik)\n3. Cek tidak ada perintah PENDING yang sedang berlangsung\n4. Simpan record PENDING ke valve_commands\n5. Publish pesan cmd ke broker Mosquitto (swm/{device_id}/cmd)\n6. Balas 202 Accepted dengan command_id dan status PENDING",
        "operationId": "create_valve_command_v1_rooms__room_id__valve_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "room_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Room Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ValveCommandCreateRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValveCommandCreateResponse"
                }
              }
            }
          },
          "422": {
