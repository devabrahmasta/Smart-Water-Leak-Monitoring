{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://smartwater.timunmania.id/schemas/status.json",
  "title": "StatusPayload",
  "description": "Payload status valve dari perangkat ke broker saat boot atau saat tombol fisik ditekan",
  "type": "object",
  "properties": {
    "msg_id": {
      "type": "integer",
      "minimum": 1,
      "description": "Nomor urut pesan monoton per perangkat, tahan reboot"
    },
    "ts": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "Timestamp ISO 8601 UTC dari NTP, null jika NTP belum sinkron"
    },
    "valve": {
      "type": "string",
      "enum": ["OPEN", "CLOSED"],
      "description": "Status posisi valve saat ini"
    },
    "source": {
      "type": "string",
      "enum": ["MANUAL_BUTTON", "BOOT"],
      "description": "Pemicu perubahan atau pengiriman status"
    }
  },
  "required": ["msg_id", "ts", "valve", "source"],
  "additionalProperties": false
}

