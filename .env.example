# Salin ke .env lalu isi nilainya. File .env tidak boleh di-commit.

# ---- PostgreSQL ----
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=smartwater
POSTGRES_PORT=5432
DATABASE_URL=

# ---- Mosquitto (akun backend) ----
MQTT_HOST=localhost
MQTT_PORT=8883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CA_CERT=infra/mosquitto/certs/ca.crt

# ---- REST API ----
API_OWNER_TOKEN=
API_PORT=8000
TZ_DISPLAY=Asia/Jakarta

# ---- Firebase Cloud Messaging ----
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_PATH=

# ---- Simulator (kamar 2) ----
SIM_DEVICE_ID=2
SIM_MQTT_USERNAME=
SIM_MQTT_PASSWORD=
